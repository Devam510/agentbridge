# AgentBridge Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# OpenAI API Key (for capability inference)
OPENAI_API_KEY=sk-...

# AgentBridge Platform
AGENTBRIDGE_ENV=development
AGENTBRIDGE_PORT=3000

# Database (Phase 3+)
DATABASE_URL=postgresql://localhost:5432/agentbridge

# Redis (Phase 3+)
REDIS_URL=redis://localhost:6379
