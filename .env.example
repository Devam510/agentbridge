# AgentBridge Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# LLM API Keys (for capability inference - Provide AT LEAST ONE)
OPENAI_API_KEY=sk-...
GROK_API_KEY=xai-...
GROQ_API_KEY=gsk-...

# AgentBridge Platform
AGENTBRIDGE_ENV=development
AGENTBRIDGE_PORT=3000

# Database (Phase 3+)
DATABASE_URL=postgresql://localhost:5432/agentbridge

# Redis (Phase 3+)
REDIS_URL=redis://localhost:6379
