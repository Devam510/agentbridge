{
  "manifest_version": 3,
  "name": "AgentBridge",
  "version": "2.0.0",
  "description": "Bridge any website to your AI agent. Automate, record, and synthesize workflows with AI.",
  "permissions": ["activeTab", "storage", "nativeMessaging", "alarms", "notifications", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["state-injector-content.js", "executor-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["recorder-content.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
