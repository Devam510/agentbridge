{
  "manifest_version": 3,
  "name": "AgentBridge",
  "version": "1.0.0",
  "description": "Bridge any website to your AI agent (Claude, Cursor) in 30 seconds.",
  "permissions": ["activeTab", "storage", "nativeMessaging", "alarms", "notifications", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["executor-content.js"],
      "run_at": "document_idle"
    }
  ]
}
