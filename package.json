{
  "name": "agentbridge",
  "version": "0.1.0",
  "description": "Make any software agent-native in 5 minutes",
  "private": true,
  "bin": {
    "agentbridge": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "verify:phase1a": "npx tsx tasks/verify-phase1a.ts",
    "verify:phase1e": "npx tsx tasks/verify-phase1e.ts",
    "verify:phase2a": "npx tsx tasks/verify-phase2a.ts",
    "verify:phase2b": "npx tsx tasks/verify-phase2b.ts",
    "verify:phase3a": "npx tsx tasks/verify-phase3a.ts",
    "verify:phase3b": "npx tsx tasks/verify-phase3b.ts",
    "verify:phase4": "npx tsx tasks/verify-phase4.ts",
    "verify:all": "npm run verify:phase1a && npm run verify:phase1e && npm run verify:phase2a && npm run verify:phase2b && npm run verify:phase3a && npm run verify:phase3b && npm run verify:phase4",
    "agentbridge": "npx tsx cli/index.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/keytar": "^4.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "keytar": "^7.9.0",
    "node-cron": "^4.2.1",
    "node-llama-cpp": "^3.18.1",
    "openai": "^6.35.0",
    "ora": "^8.0.0",
    "playwright": "^1.44.0",
    "ws": "^8.20.0",
    "zod": "^3.23.0"
  }
}
